# Public browser config (safe to expose: access is enforced by Supabase Row Level Security).
# Supabase dashboard -> Project Settings -> API
# Use the bare project URL. Do NOT copy the REST endpoint (https://<ref>.supabase.co/rest/v1/).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# NEVER put the service_role key in any VITE_* variable: Vite ships those to the browser.
